@page "/notes/{*Path}"
@inject MarkdownContentService Content
@inject IJSRuntime JsRuntime

@if (_note is null)
{
    <h1>기록을 찾을 수 없습니다.</h1>

    <p>
        <a href="">Home</a>
    </p>
}
else
{
    <PageTitle>@_note.Title</PageTitle>

    <nav>
        <a href="">Home</a>
    </nav>

    <hr />

    @((MarkupString)_html)
}

@code {
    [Parameter]
    public string? Path { get; set; }

    private Models.Note? _note;
    private string _html = string.Empty;
    private bool _shouldHighlight;

    protected override void OnParametersSet()
    {
        _note = Path is null ? null : Content.GetNote(Path);
        _html = _note is null ? string.Empty : Content.RenderHtml(_note);
        _shouldHighlight = _note is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldHighlight)
        {
            _shouldHighlight = false;
            await JsRuntime.InvokeVoidAsync("syntaxHighlight.highlight");
        }
    }
}
