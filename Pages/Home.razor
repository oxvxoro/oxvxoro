@page "/"
@inject MarkdownContentService Content

<PageTitle>oxvxoro</PageTitle>

<h1>oxvxoro</h1>

<p>기록용?</p>

<nav>
    <a href="">Home</a>
</nav>

<hr />

<h2>Notes</h2>

@{
    var notes = Content.GetNotes();
}

@if (notes.Count == 0)
{
    <p>아직 작성된 기록이 없습니다.</p>
}
else
{
    <ul>
        @foreach (var note in notes)
        {
            <li>
                <a href="notes/@note.Route">@note.Title</a>
                — @note.Date.ToString("yyyy-MM-dd") — @note.Category
            </li>
        }
    </ul>
}
